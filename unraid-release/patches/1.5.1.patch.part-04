--- a/docker-compose.yml
+++ b/docker-compose.yml
@@ -3,7 +3,7 @@ services:
     build:
       context: .
       dockerfile: Dockerfile
-    image: local/rclone-manager-unraid:1.4.0
+    image: local/rclone-manager-unraid:1.5.1
     container_name: rclone-manager
     restart: unless-stopped
     init: true
diff --git a/update.sh b/update.sh
index b55b252..4c89c50 100755
--- a/update.sh
+++ b/update.sh
@@ -2,7 +2,7 @@
 set -euo pipefail
 cd "$(dirname "$0")"
 
-VERSION="$(cat VERSION 2>/dev/null || echo 1.4.0)"
+VERSION="$(cat VERSION 2>/dev/null || echo 1.5.1)"
 mkdir -p backups data
 
 printf '[1/5] Preparando mounts...\n'
