+      const n=document.createElement('div');n.className='browsername';const b=document.createElement('button');b.type='button';b.textContent=item.name;b.title=item.path;b.addEventListener('click',()=>{if(item.is_dir){destPath=item.path;searchMode=false;if(search)search.value='';loadDest()}});n.appendChild(b);
