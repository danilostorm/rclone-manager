th, relative_path, file_name, int(size_bytes or 0), mime_type or "application/octet-stream", conflict_mode or "replace", fingerprint or "", now, now),
+        )
+        return cur.lastrowid
+
+
+def get_upload_job(job_id):
+    with db_conn() as db:
+        row = db.execute("SELECT * FROM upload_jobs WHERE id=?", (int(job_id),)).fetchone()
+        return dict(row) if row else None
+
+
+def list_upload_jobs(limit=100):
+    with db_conn() as db:
+        return [dict(row) for row in db.execute("SELECT * FROM upload_jobs ORDER BY id DESC LIMIT ?", (int(limit),))]
+
+
+def update_upload_job(job_id, **fields):
+    if not fields:
+        return
+    if "updated_at" not in fields:
+        fields["updated_at"] = utcnow()
+    allowed = {
+        "destination_slug","destination_path","relative_path","final_path","file_name","size_bytes","mime_type",
+        "conflict_mode","fingerprint","status","progress","uploaded_bytes","session_url","google_file_id",
+        "last_error","updated_at","finished_at"
+    }
+    clean = {k:v for k,v in fields.items() if k in allowed}
+    if not clean:
+        return
+    cols=list(clean.keys())
+    with db_conn() as db:
+        db.execute(f"UPDATE upload_jobs SET {', '.join(f'{c} = ?' for c in cols)} WHERE id = ?", [clean[c] for c in cols]+[int(job_id)])
+
+
+def delete_upload_job(job_id):
+    with db_conn() as db:
+        db.execute("DELETE FROM upload_jobs WHERE id=?", (int(job_id),))
+
+
+def clear_finished_uploads():
+    with db_conn() as db:
+        db.execute("DELETE FROM upload_jobs WHERE status IN ('completed','skipped','cancelled')")
diff --git a/app/oauth_google.py b/app/oauth_google.py
index 92b8fae..da42cab 100644
--- a/app/oauth_google.py
+++ b/app/oauth_google.py
@@ -140,3 +140,69 @@ def update_root_folder_id(slug, root_folder_id=""):
     os.chmod(tmp, 0o600)
     os.replace(tmp, path)
     os.chmod(path, 0o600)
+
+
+def get_valid_access_token(slug, force_refresh=False):
+    """Return a current OAuth access token and persist refreshes to rclone.conf."""
+    path = config_path(slug)
+    if not path.exists():
+        raise RuntimeError("rclone.conf não encontrado")
+    cfg = configparser.RawConfigParser()
+    cfg.optionxform = str
+    cfg.read(path)
+    if slug not in cfg:
+        raise RuntimeError(f"Remote {slug} não existe no rclone.conf")
+    section = cfg[slug]
+    try:
+        token = json.loads(section.get("token", "{}"))
+    except Exception:
+        token = {}
+    access_token = token.get("access_token", "")
+    expiry_raw = token.get("expiry", "")
+    fresh = False
+    if access_token and not force_refresh:
+        try:
+            expiry = datetime.fromisoformat(expiry_raw.replace("Z", "+00:00"))
+            fresh = expiry > datetime.now(timezone.utc) + timedelta(minutes=2)
+        except Exception:
+            fresh = False
+    if fresh:
+        return access_token
+    refresh_token = token.get("refresh_token", "")
+    client_id = section.get("client_id", "")
+    client_secret = section.get("client_secret", "")
+    if not refresh_token or not client_id or not client_secret:
+        if access_token and not force_refresh:
+            return access_token
+        raise RuntimeError("Token OAuth expirou e não há refresh_token/credenciais para renovar. Reautorize a conta.")
+    r = requests.post(
+        TOKEN_URL,
+        data={
+            "client_id": client_id,
+            "client_secret": client_secret,
+            "refresh_token": refresh_token,
+            "grant_type": "refresh_token",
+        },
+        timeout=30,
+    )
+    if not r.ok:
+        raise RuntimeError(f"Falha renovando OAuth do Google (HTTP {r.status_code}): {(r.text or '')[:800]}")
+    payload = r.json()
+    token["access_token"] = payload["access_token"]
+    token["token_type"] = payload.get("token_type", token.get("token_type", "Bearer"))
+    expires_in = int(payload.get("expires_in", 3600))
+    token["expiry"] = (datetime.now(timezone.utc) + timedelta(seconds=expires_in)).isoformat().replace("+00:00", "Z")
+    section["token"] = json.dumps(token, separators=(",", ":"))
+    tmp = Path(str(path) + ".tmp")
+    with tmp.open("w", encoding="utf-8") as f:
+        cfg.write(f, space_around_delimiters=True)
+    try:
+        os.chmod(tmp, 0o600)
+    except Exception:
+        pass
+    os.replace(tmp, path)
+    try:
+        os.chmod(path, 0o600)
+    except Exception:
+        pass
+    return token["access_token"]
