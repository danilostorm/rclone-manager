+
+@app.route("/uploads")
+def uploads_page():
+    accounts = list_accounts()
+    writable = [a for a in accounts if a.get("access_scope") == "readwrite"]
+    jobs = list_upload_jobs(150)
+    try:
+        quota_gb = max(1.0, float(get_setting("quota_reference_gb", "750") or 750))
+    except Exception:
+        quota_gb = 750.0
+    quota_limit = int(quota_gb * 1000 * 1000 * 1000)
+    quota_rows = []
+    for a in writable:
+        used = transfer_usage_24h(a["slug"])
+        quota_rows.append({
+            "slug": a["slug"],
+            "email": a.get("email") or "",
+            "used": used,
+            "limit": quota_limit,
+            "pct": min(100.0, (used * 100.0 / quota_limit) if quota_limit else 0.0),
+            "remaining": max(0, quota_limit - used),
+        })
+    return render_template("uploads.html", accounts=accounts, writable=writable, jobs=jobs, quota_rows=quota_rows, quota_gb=quota_gb)
+
+
+@app.route("/api/uploads/prepare", methods=["POST"])
+@require_csrf
+def api_upload_prepare():
+    payload = request.get_json(silent=True) or {}
+    slug = normalize_slug(payload.get("destination_slug", ""))
+    if not get_account(slug):
+        return jsonify({"ok": False, "error": "Conta de destino não encontrada"}), 404
+    try:
+        job = uploads.prepare(
+            destination_slug=slug,
+            destination_path=payload.get("destination_path", ""),
+            relative_path=payload.get("relative_path", ""),
+            file_name=payload.get("file_name", ""),
+            size_bytes=payload.get("size_bytes", 0),
+            mime_type=payload.get("mime_type", "application/octet-stream"),
+            conflict_mode=payload.get("conflict_mode", "replace"),
+            fingerprint=payload.get("fingerprint", ""),
+        )
+        return jsonify({"ok": True, "job": job})
+    except PermissionError as exc:
+        return jsonify({"ok": False, "error": str(exc)}), 403
+    except Exception as exc:
+        return jsonify({"ok": False, "error": str(exc)}), 400
+
+
+@app.route("/api/uploads/<int:job_id>/chunk", methods=["PUT"])
+@require_csrf
+def api_upload_chunk(job_id):
+    try:
+        content_length = int(request.content_length or 0)
+    except Exception:
+        content_length = 0
+    # The UI tops out at 64 MiB. Keep a small margin while protecting the
+    # local service against accidental giant request bodies.
+    if content_length > 70 * 1024 * 1024:
+        return jsonify({"ok": False, "error": "Chunk maior que 70 MiB"}), 413
+    try:
+        start = int(request.headers.get("X-Chunk-Start", "0") or 0)
+        data = request.get_data(cache=False)
+        job = uploads.put_chunk(job_id, start, data)
+        return jsonify({"ok": True, "job": job})
+    except KeyError as exc:
+        return jsonify({"ok": False, "error": str(exc)}), 404
+    except Exception as exc:
+        expected = getattr(exc, "expected_offset", None)
+        body = {"ok": False, "error": str(exc)}
+        if expected is not None:
+            body["expected_offset"] = int(expected)
+        code = 409 if expected is not None else 429 if "HTTP 429" in str(exc) else 400
+        return jsonify(body), code
+
+
+@app.route("/api/uploads")
+def api_uploads():
+    return jsonify(list_upload_jobs(150))
+
+
+@app.route("/uploads/<int:job_id>/cancel", methods=["POST"])
+@require_csrf
+def upload_cancel(job_id):
+    if not get_upload_job(job_id):
+        abort(404)
+    uploads.cancel(job_id)
+    flash(f"Upload #{job_id} cancelado.", "warning")
+    return redirect(url_for("uploads_page"))
+
+
+@app.route("/uploads/<int:job_id>/delete", methods=["POST"])
+@require_csrf
+def upload_delete(job_id):
+    if not get_upload_job(job_id):
+        abort(404)
+    uploads.delete(job_id)
+    flash(f"Histórico do upload #{job_id} removido. O arquivo já enviado ao Google Drive não é apagado.", "success")
+    return redirect(url_for("uploads_page"))
+
+
+@app.route("/uploads/clear", methods=["POST"])
+@require_csrf
+def upload_clear_finished():
+    clear_finished_uploads()
+    flash("Histórico de uploads finalizados limpo.", "success")
+    return redirect(url_for("uploads_page"))
+
+
