--- /dev/null
+++ b/app/uploads.py
@@ -0,0 +1,452 @@
+import configparser
+import json
+import os
+import re
+import threading
+from datetime import datetime, timedelta, timezone
+from pathlib import PurePosixPath
+
+import requests
+
+from db import (
+    add_transfer_usage,
+    create_upload_job,
+    delete_upload_job,
+    get_account,
+    get_upload_job,
+    list_upload_jobs,
+    update_upload_job,
+    utcnow,
+)
+from oauth_google import get_valid_access_token
+from utils import config_path
+
+DRIVE_API = "https://www.googleapis.com/drive/v3"
+DRIVE_UPLOAD_API = "https://www.googleapis.com/upload/drive/v3"
+FOLDER_MIME = "application/vnd.google-apps.folder"
+SESSION_RANGE_RE = re.compile(r"bytes=0-(\d+)")
+
+
+def _safe_path(value):
+    value = (value or "").replace("\\", "/").strip().strip("/")
+    parts = []
+    for raw in value.split("/"):
+        if raw in {"", "."}:
+            continue
+        if raw == ".." or "\x00" in raw:
+            raise ValueError("Caminho inválido")
+        parts.append(raw)
+    return "/".join(parts)
+
+
+def _safe_name(value):
+    value = str(value or "").strip()
+    if not value or value in {".", ".."} or "/" in value or "\\" in value or "\x00" in value:
+        raise ValueError("Nome de arquivo inválido")
+    if len(value) > 255:
+        raise ValueError("Nome de arquivo muito longo")
+    return value
+
+
+def _join(*parts):
+    clean = [_safe_path(p) for p in parts if p]
+    return "/".join(p for p in clean if p)
+
+
+def _escape_q(value):
+    return str(value).replace("\\", "\\\\").replace("'", "\\'")
+
+
+def _cfg_root_folder(slug):
+    account = get_account(slug) or {}
+    if account.get("root_folder_id"):
+        return str(account["root_folder_id"]).strip()
+    path = config_path(slug)
+    if path.exists():
+        cfg = configparser.RawConfigParser()
+        cfg.read(path)
+        if slug in cfg and cfg[slug].get("root_folder_id"):
+            return cfg[slug].get("root_folder_id").strip()
+    return "root"
+
+
+def _headers(slug):
+    return {"Authorization": f"Bearer {get_valid_access_token(slug)}"}
+
+
+def _request_json(method, url, slug, *, params=None, json_body=None, timeout=45):
+    headers = _headers(slug)
+    r = requests.request(method, url, headers=headers, params=params, json=json_body, timeout=timeout)
+    if r.status_code == 401:
+        # Force one refresh attempt if the provider rejected the cached token.
+        headers = {"Authorization": f"Bearer {get_valid_access_token(slug, force_refresh=True)}"}
+        r = requests.request(method, url, headers=headers, params=params, json=json_body, timeout=timeout)
+    if not r.ok:
+        detail = ""
+        try:
+            payload = r.json()
+            detail = payload.get("error", {}).get("message") or json.dumps(payload, ensure_ascii=False)
+        except Exception:
+            detail = r.text
+        raise RuntimeError(f"Google Drive API HTTP {r.status_code}: {(detail or 'erro desconhecido')[:1000]}")
+    return r.json() if r.content else {}
+
+
+def _find_children(slug, parent_id, name):
+    q = f"'{_escape_q(parent_id)}' in parents and name = '{_escape_q(name)}' and trashed = false"
+    data = _request_json(
+        "GET",
+        f"{DRIVE_API}/files",
+        slug,
+        params={
+            "q": q,
+            "fields": "files(id,name,mimeType,size,modifiedTime)",
+            "pageSize": 100,
+            "spaces": "drive",
+            "supportsAllDrives": "true",
+            "includeItemsFromAllDrives": "true",
+        },
+    )
+    return data.get("files", [])
+
+
+def _ensure_folder(slug, parent_id, name):
+    for item in _find_children(slug, parent_id, name):
+        if item.get("mimeType") == FOLDER_MIME:
+            return item["id"]
+    data = _request_json(
+        "POST",
+        f"{DRIVE_API}/files",
+        slug,
+        params={"supportsAllDrives": "true", "fields": "id,name"},
+        json_body={"name": name, "mimeType": FOLDER_MIME, "parents": [parent_id]},
+    )
+    return data["id"]
+
+
+class UploadManager:
+    """Chunked browser -> Google Drive resumable uploader.
+
+    Files never need to be stored as complete local files by Rclone Manager.
+    The browser sends bounded chunks and each chunk is immediately forwarded to
+    Google's resumable upload endpoint. The session URI/offset are persisted so
+    the same file can be selected again and resumed after a restart.
+    """
+
+    def __init__(self):
+        self.lock = threading.RLock()
+        self.folder_cache = {}
+        self.cancelled = set()
+
+    def _require_writable(self, slug):
+        account = get_account(slug)
+        if not account:
+            raise RuntimeError("Conta não encontrada")
+        if account.get("access_scope") != "readwrite":
+            raise PermissionError(f"A conta {slug} precisa de permissão de escrita para receber uploads.")
+        return account
+
+    def _folder_id(self, slug, path):
+        path = _safe_path(path)
+        key = (slug, path)
+        with self.lock:
+            if key in self.folder_cache:
+                return self.folder_cache[key]
+        parent = _cfg_root_folder(slug)
+        built = ""
+        for part in [p for p in path.split("/") if p]:
+            built = _join(built, part)
+            cache_key = (slug, built)
+            with self.lock:
+                cached = self.folder_cache.get(cache_key)
+            if cached:
+                parent = cached
+                continue
+            parent = _ensure_folder(slug, parent, part)
+            with self.lock:
+                self.folder_cache[cache_key] = parent
+        with self.lock:
+            self.folder_cache[key] = parent
+        return parent
+
+    def _existing_target(self, slug, parent_id, name):
+        rows = _find_children(slug, parent_id, name)
+        files = [x for x in rows if x.get("mimeType") != FOLDER_MIME]
+        return files[0] if files else None
+
+    def _unique_name(self, slug, parent_id, name):
+        if not _find_children(slug, parent_id, name):
+            return name
+        p = PurePosixPath(name)
+        suffix = "".join(p.suffixes)
+        stem = name[:-len(suffix)] if suffix else name
+        for n in range(1, 1001):
+            candidate = f"{stem} ({n}){suffix}"
+            if not _find_children(slug, parent_id, candidate):
+                return candidate
+        raise RuntimeError("Não foi possível gerar um nome livre no destino")
+
+    def _create_session(self, job):
+        slug = job["destination_slug"]
+        self._require_writable(slug)
+        relative = _safe_path(job.get("relative_path") or job.get("file_name"))
+        rel_parent = str(PurePosixPath(relative).parent)
+        rel_parent = "" if rel_parent == "." else _safe_path(rel_parent)
+        destination_dir = _join(job.get("destination_path", ""), rel_parent)
+        parent_id = self._folder_id(slug, destination_dir)
+        original_name = _safe_name(PurePosixPath(relative).name)
+        conflict = job.get("conflict_mode") or "replace"
+        existing = self._existing_target(slug, parent_id, original_name)
+        final_name = original_name
+        existing_id = None
+
+        if existing:
+            if conflict == "skip":
+                update_upload_job(
+                    job["id"], status="skipped", progress=100.0,
+                    uploaded_bytes=int(job.get("size_bytes") or 0),
+                    final_path=_join(destination_dir, original_name),
+                    google_file_id=existing.get("id", ""),
+                    session_url="", finished_at=utcnow(), last_error="Arquivo já existe; ignorado conforme a opção selecionada.",
+                )
+                return None
+            if conflict == "rename":
+                final_name = self._unique_name(slug, parent_id, original_name)
+            else:
+                existing_id = existing.get("id")
+
+        size = int(job.get("size_bytes") or 0)
+        mime = job.get("mime_type") or "application/octet-stream"
+        if size == 0:
+            if existing_id:
+                # A metadata-only PATCH would leave the old file contents intact.
+                # Use a zero-byte media upload so "replace" really truncates the file.
+                headers = _headers(slug)
+                headers.update({"Content-Type": mime, "Content-Length": "0"})
+                media_url = f"{DRIVE_UPLOAD_API}/files/{existing_id}"
+                params = {"uploadType": "media", "supportsAllDrives": "true", "fields": "id,name"}
+                r = requests.patch(media_url, headers=headers, params=params, data=b"", timeout=45)
+                if r.status_code == 401:
+                    headers["Authorization"] = f"Bearer {get_valid_access_token(slug, force_refresh=True)}"
+                    r = requests.patch(media_url, headers=headers, params=params, data=b"", timeout=45)
+                if r.status_code not in {200, 201}:
+                    raise RuntimeError(f"Não foi possível substituir o arquivo vazio no Google (HTTP {r.status_code}): {(r.text or '')[:800]}")
+                data = r.json() if r.content else {}
+                file_id = data.get("id") or existing_id
+            else:
+                data = _request_json("POST", f"{DRIVE_API}/files", slug, params={"supportsAllDrives": "true", "fields": "id,name"}, json_body={"name": final_name, "parents": [parent_id]})
+                file_id = data.get("id", "")
+            update_upload_job(job["id"], status="completed", progress=100.0, uploaded_bytes=0, final_path=_join(destination_dir, final_name), google_file_id=file_id, session_url="", finished_at=utcnow(), last_error="")
+            return None
+        headers = _headers(slug)
+        headers.update({
+            "Content-Type": "application/json; charset=UTF-8",
+            "X-Upload-Content-Type": mime,
+            "X-Upload-Content-Length": str(size),
+        })
+        if existing_id:
+            url = f"{DRIVE_UPLOAD_API}/files/{existing_id}"
+            method = "PATCH"
+            metadata = {"name": final_name}
+        else:
+            url = f"{DRIVE_UPLOAD_API}/files"
+            method = "POST"
+            metadata = {"name": final_name, "parents": [parent_id]}
+        r = requests.request(
+            method,
+            url,
+            headers=headers,
+            params={"uploadType": "resumable", "supportsAllDrives": "true"},
+            json=metadata,
+            timeout=45,
+        )
+        if r.status_code == 401:
+            headers["Authorization"] = f"Bearer {get_valid_access_token(slug, force_refresh=True)}"
+            r = requests.request(method, url, headers=headers, params={"uploadType": "resumable", "supportsAllDrives": "true"}, json=metadata, timeout=45)
+        if r.status_code not in {200, 201} or not r.headers.get("Location"):
+            raise RuntimeError(f"Não foi possível abrir sessão de upload no Google (HTTP {r.status_code}): {(r.text or '')[:800]}")
+        session_url = r.headers["Location"]
+        final_path = _join(destination_dir, final_name)
+        update_upload_job(job["id"], session_url=session_url, final_path=final_path, google_file_id=existing_id or "", status="ready", last_error="")
+        return session_url
+
+    def _query_session(self, job):
+        session_url = job.get("session_url") or ""
+        if not session_url:
+            return int(job.get("uploaded_bytes") or 0), False
+        slug = job["destination_slug"]
+        total = int(job.get("size_bytes") or 0)
+        try:
+            r = requests.put(
+                session_url,
+                headers={
+                    **_headers(slug),
+                    "Content-Length": "0",
+                    "Content-Range": f"bytes */{tot