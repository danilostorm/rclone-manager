kitdirectory directory hidden>
+    </div>
+
+    <div class="form-grid upload-options" style="margin-top:14px">
+      <div class="field"><label>Se já existir arquivo com o mesmo nome</label><select class="select" id="uploadConflict"><option value="replace">Substituir</option><option value="rename">Manter os dois (renomear novo)</option><option value="skip">Ignorar o existente</option></select></div>
+      <div class="field"><label>Uploads simultâneos</label><select class="select" id="uploadParallel"><option value="1">1</option><option value="2" selected>2</option><option value="3">3</option><option value="4">4</option></select></div>
+      <div class="field"><label>Tamanho de cada bloco</label><select class="select" id="uploadChunk"><option value="8">8 MiB</option><option value="16" selected>16 MiB</option><option value="32">32 MiB</option><option value="64">64 MiB</option></select></div>
+      <div class="field"><label>Estrutura de pastas</label><label class="checkline"><input type="checkbox" id="uploadPreserveTree" checked> Preservar subpastas da seleção</label></div>
+    </div>
+
+    <div class="upload-summary" style="margin-top:14px"><div><strong id="uploadTotalSize">0 B</strong><span class="muted"> selecionados</span></div><div class="progress"><span id="uploadTotalBar" style="width:0%"></span></div><div class="muted" id="uploadTotalText">0%</div></div>
+    <div class="actions" style="margin-top:12px"><button class="btn primary" type="button" id="uploadStart" disabled>⇧ Iniciar upload</button><button class="btn" type="button" id="uploadPause" disabled>Pausar</button><button class="btn danger" type="button" id="uploadClearQueue">Limpar fila</button></div>
+    <div class="upload-queue" id="uploadQueue"><div class="empty">Nenhum arquivo selecionado.</div></div>
+  </div>
+</div>
+
+<div class="card" style="margin-top:16px">
+  <div class="section-title"><div><h2>Histórico de uploads</h2><div class="muted">Uploads interrompidos podem ser retomados selecionando novamente o mesmo arquivo/pasta.</div></div></div>
+  <div class="tablewrap"><table class="table" id="uploadHistory"><thead><tr><th>#</th><th>Arquivo → Drive</th><th>Status</th><th>Progresso</th><th>Ações</th></tr></thead><tbody>
+  {% for j in jobs %}
+    <tr data-upload-job="{{ j.id }}"><td>{{ j.id }}</td><td><strong>{{ j.file_name }}</strong> → <strong>{{ j.destination_slug }}</strong><div class="muted mono">/{{ j.final_path or (j.destination_path ~ '/' ~ j.relative_path)|trim('/') }}</div><div class="muted">{{ '%.2f'|format((j.size_bytes or 0) / 1024 / 1024 / 1024) }} GiB</div></td><td><span class="badge {{ 'mounted' if j.status=='completed' else 'starting' if j.status in ['uploading','ready','queued'] else 'waiting' if j.status=='waiting_quota' else 'error' if j.status=='error' else 'stopped' }} upload-status">{{ j.status }}</span>{% if j.last_error %}<div class="muted job-error upload-error">{{ j.last_error }}</div>{% endif %}</td><td><div class="progress"><span style="width:{{ j.progress }}%"></span></div><div class="muted upload-progress">{{ '%.1f'|format(j.progress) }}% · {{ j.uploaded_bytes|default(0) }} / {{ j.size_bytes|default(0) }} bytes</div></td><td><div class="actions">{% if j.status not in ['completed','skipped','cancelled'] %}<form method="post" action="{{ url_for('upload_cancel', job_id=j.id) }}"><input type="hidden" name="csrf_token" value="{{ csrf_token() }}"><button class="btn small danger" type="submit">Cancelar</button></form>{% endif %}<form method="post" action="{{ url_for('upload_delete', job_id=j.id) }}"><input type="hidden" name="csrf_token" value="{{ csrf_token() }}"><button class="btn small" type="submit">Excluir histórico</button></form></div></td></tr>
+  {% else %}<tr><td colspan="5"><div class="empty">Nenhum upload ainda.</div></td></tr>{% endfor %}
+  </tbody></table></div>
+</div>
+{% endblock %}
+{% block scripts %}
+<script>window.RCLONE_UPLOAD_PAGE=true;window.RCLONE_CSRF={{ csrf_token()|tojson }};</script>
+{% endblock %}
diff --git a/mnt/data/patchgen/new/u/app/uploads.py b/app/uploads.py
new file mode 100644
