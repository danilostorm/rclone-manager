diff --git a/mnt/data/patchgen/new/u/app/templates/uploads.html b/app/templates/uploads.html
new file mode 100644
index 0000000..a6c1133
--- /dev/null
+++ b/app/templates/uploads.html
@@ -0,0 +1,74 @@
+{% extends 'base.html' %}
+{% block title %}Upload · Rclone Manager{% endblock %}
+{% block content %}
+<div class="topbar">
+  <div><h1>Upload para o Drive</h1><div class="sub">Envie arquivos e pastas do seu computador diretamente para qualquer Google Drive conectado.</div></div>
+  <form method="post" action="{{ url_for('upload_clear_finished') }}"><input type="hidden" name="csrf_token" value="{{ csrf_token() }}"><button class="btn" type="submit">Limpar finalizados</button></form>
+</div>
+
+<div class="notice upload-hero" style="margin-bottom:16px">
+  <strong>Upload em partes + retomada.</strong> O navegador envia blocos de até 64 MiB e o Manager repassa cada bloco para uma sessão resumível do Google Drive. Assim, um arquivo grande não precisa ficar inteiro armazenado pelo Rclone Manager. Se cair a conexão, selecione novamente o mesmo arquivo e ele tenta continuar do último bloco confirmado pelo Google.
+</div>
+
+{% if not writable %}
+<div class="notice warn" style="margin-bottom:16px"><strong>Nenhuma conta com escrita.</strong> Abra uma conta e use <strong>Habilitar cópias para esta conta</strong>. Essa mesma permissão é usada para Upload; os mounts continuam read-only.</div>
+{% endif %}
+
+{% if quota_rows %}
+<div class="card quota-card" style="margin-bottom:16px">
+  <div class="section-title"><h2>Cota de cópia/upload · estimativa 24h</h2><span class="badge stopped">Referência {{ '%.0f'|format(quota_gb) }} GB</span></div>
+  <div class="quota-grid">
+  {% for q in quota_rows %}
+    <div class="quota-item"><div><strong>{{ q.slug }}</strong>{% if q.email %}<div class="muted">{{ q.email }}</div>{% endif %}</div><div class="progress"><span style="width:{{ '%.1f'|format(q.pct) }}%"></span></div><div><strong>{{ '%.1f'|format(q.used / 1000 / 1000 / 1000) }} GB</strong> registrados pelo Manager <span class="muted">· {{ '%.1f'|format(q.remaining / 1000 / 1000 / 1000) }} GB restantes estimados</span></div></div>
+  {% endfor %}
+  </div>
+</div>
+{% endif %}
+
+<div class="grid upload-grid">
+  <div class="card span-5">
+    <div class="section-title"><h2>1. Destino</h2><span class="badge mounted">Escrita</span></div>
+    <div class="field"><label>Google Drive</label><select class="select" id="uploadDestination">{% for a in writable %}<option value="{{ a.slug }}">{{ a.slug }}{% if a.email %} · {{ a.email }}{% endif %}</option>{% endfor %}</select></div>
+    <div class="browserbar"><button class="btn small" type="button" id="uploadDestUp">↑ Voltar</button><div class="path mono" id="uploadDestPath">/</div><button class="btn small" type="button" id="uploadDestRefresh">Atualizar</button></div>
+    <div class="browser-tools">
+      <div class="browser-search"><input class="input" id="uploadDestSearch" placeholder="Buscar pasta no destino..."><button class="btn small" type="button" id="uploadDestSearchBtn">Buscar</button><button class="btn small" type="button" id="uploadDestClearSearch">Limpar</button></div>
+      <div class="actions"><button class="btn small primary" type="button" id="uploadDestNewFolder">＋ Criar pasta</button></div>
+    </div>
+    <div class="filebrowser upload-browser" id="uploadDestBrowser">{% if writable %}<div class="empty">Carregando...</div>{% else %}<div class="empty">Nenhuma conta com escrita.</div>{% endif %}</div>
+    <div class="notice" style="margin-top:12px">A pasta aberta será o destino dos arquivos. Pastas existentes dentro da seleção são criadas automaticamente quando necessário.</div>
+  </div>
+
+  <div class="card span-7">
+    <div class="section-title"><h2>2. Arquivos do computador</h2><span class="badge stopped" id="uploadSelectionBadge">0 arquivos</span></div>
+    <div class="upload-drop" id="uploadDropZone" tabindex="0">
+      <div class="upload-drop-icon">⇧</div><strong>Arraste arquivos para cá</strong><span>ou escolha arquivos / uma pasta inteira</span>
+      <div class="actions"><button class="btn primary" type="button" id="uploadChooseFiles">＋ Arquivos</button><button class="btn" type="button" id="uploadChooseFolder">📁 Pasta inteira</button></div>
+      <input type="file" id="uploadFileInput" multiple hidden>
+      <input type="file" id="uploadFolderInput" multiple web