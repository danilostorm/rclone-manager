ytes(item.size);
+      r.append(icon,n,m);browser.appendChild(r);
+    });
+  }
+  async function loadDest(){
+    if(!dest?.value){browser.innerHTML='<div class="empty">Nenhum destino com escrita.</div>';return}
+    destPathEl.textContent='/'+destPath;browser.innerHTML='<div class="empty">Carregando...</div>';
+    try{const d=await browseDrive(dest.value,'drive',destPath);searchMode=false;renderDestRows(d.items)}catch(e){browser.innerHTML=`<div class="flash danger" style="margin:12px">${escapeHtml(e.message)}</div>`}
+  }
+  async function doSearch(){
+    const q=(search?.value||'').trim();if(q.length<2)return alert('Digite pelo menos 2 caracteres.');
+    browser.innerHTML='<div class="empty">Buscando...</div>';
+    try{const d=await searchDrive(dest.value,'drive',destPath,q);searchMode=true;renderDestRows(d.items.filter(x=>x.is_dir))}catch(e){alert(e.message)}
+  }
+  function escapeHtml(v){const d=document.createElement('div');d.textContent=v||'';return d.innerHTML}
+  async function createFolder(){
+    if(!dest?.value)return alert('Nenhum Drive com escrita.');
+    const name=prompt('Nome da nova pasta:');if(!name)return;
+    try{await apiPost('/api/fileops/mkdir',{slug:dest.value,view:'drive',path:destPath,name});await loadDest()}catch(e){alert(e.message)}
+  }
+
+  function addFiles(list){
+    const preserve=document.getElementById('uploadPreserveTree')?.checked!==false;
+    [...list].forEach(file=>{
+      let rel=safeRel(file);if(!preserve)rel=file.name;
+      const key=fingerprint(file,rel);
+      if(queue.some(x=>x.key===key))return;
+      queue.push({key,file,relativePath:rel,status:'pending',progress:0,offset:0,jobId:null,error:'',cancelled:false});
+    });renderQueue();
+  }
+  function updateTotals(){
+    const bytes=queue.reduce((a,x)=>a+Number(x.file?.size||0),0);const done=queue.reduce((a,x)=>a+Math.min(Number(x.file?.size||0),Number(x.offset||0)),0);const pct=bytes?done*100/bytes:0;
+    badge.textContent=`${queue.length} arquivo${queue.length===1?'':'s'}`;totalSizeEl.textContent=humanBytes(bytes);totalText.textContent=`${pct.toFixed(1)}% · ${humanBytes(done)} / ${humanBytes(bytes)}`;totalBar.style.width=`${pct}%`;
+    startBtn.disabled=!queue.length||!dest?.value||running;pauseBtn.disabled=!running;pauseBtn.textContent=paused?'Continuar':'Pausar';
+  }
+  function renderQueue(){
+    queueEl.innerHTML='';if(!queue.length){queueEl.innerHTML='<div class="empty">Nenhum arquivo selecionado.</div>';updateTotals();return}
+    queue.forEach((item,idx)=>{
+      const r=document.createElement('div');r.className='upload-qrow';
+      const info=document.createElement('div');info.className='upload-qinfo';info.innerHTML=`<strong>${escapeHtml(item.relativePath)}</strong><div class="muted">${humanBytes(item.file.size)}</div>${item.error?`<div class="job-error">${escapeHtml(item.error)}</div>`:''}`;
+      const prog=document.createElement('div');prog.innerHTML=`<div class="progress"><span style="width:${item.progress||0}%"></span></div><div class="muted">${Number(item.progress||0).toFixed(1)}% · ${escapeHtml(item.status)}</div>`;
+      const acts=document.createElement('div');acts.className='actions';const rm=document.createElement('button');rm.type='button';rm.className='btn tiny danger';rm.textContent='Remover';rm.disabled=['uploading','preparing'].includes(item.status);rm.addEventListener('click',()=>{queue.splice(idx,1);renderQueue()});acts.appendChild(rm);
+      r.append(info,prog,acts);queueEl.appendChild(r);
+    });updateTotals();
+  }
+  async function prepare(item){
+    item.status='preparing';item.error='';renderQueue();
+    const conflict=document.getElementById('uploadConflict').value;
+    const payload={destination_slug:dest.value,destination_path:destPath,relative_path:item.relativePath,file_name:item.file.name,size_bytes:item.file.size,mime_type:item.file.type||'application/octet-stream',conflict_mode:conflict,fingerprint:item.key};
+    const r=await fetch('/api/uploads/prepare',{method:'POST',headers:{'Content-Type':'application/json','X-CSRF-Token':window.RCLONE_CSRF||''},body:JSON.stringify(payload)});const data=await r.json();if(!r.ok||!data.ok)throw new Error(data.error||`HTTP ${r.status}`);
+    item.jobId=data.job.id;item.offset=Number(data.job.uploaded_bytes||0);item.progress=item.file.size?item.offset*100/item.file.size:100;item.status=data.job.status;
+    if(['completed','skipped'].includes(item.status)){item.offset=item.file.size;item.progress=100}
+    renderQueue();
+  }
+  async function putChunk(item,blob,start){
+    const r=await fetch(`/api/uploads/${item.jobId}/chunk`,{method:'PUT',headers:{'X-CSRF-Token':window.RCLONE_CSRF||'','X-Chunk-Start':String(start),'Content-Type':'application/octet-stream'},body:blob});let data={};try{data=await r.json()}catch(e){}
+    if(r.status===409&&Number.isFinite(Number(data.expected_offset))){item.offset=Number(data.expected_offset);return null}
+    if(!r.ok||!data.ok)throw new Error(data.error||`HTTP ${r.status}`);return data.job;
+  }
+  async function runItem(item){
+    try{
+      if(!item.jobId||['pending','error','interrupted','waiting_quota'].includes(item.status))await prepare(item);
+      if(['completed','skipped'].includes(item.status))return;
+      const chunkBytes=Number(document.getElementById('uploadChunk').value||16)*1024*1024;
+      while(item.offset<item.file.size&&!item.cancelled){
+        while(paused&&!item.cancelled)await sleep(150);
+        if(item.cancelled)break;
+        item.status='uploading';renderQueue();const end=Math.min(item.file.size,item.offset+chunkBytes);const blob=item.file.slice(item.offset,end);const before=item.offset;const job=await putChunk(item,blob,before);
+        if(job){item.offset=Number(job.uploaded_bytes||end);item.status=job.status;item.error=job.last_error||''}else if(item.offset===before){await sleep(100);}
+        item.progress=item.file.size?item.offset*100/item.file.size:100;renderQueue();
+        if(['completed','skipped'].includes(item.status)){item.progress=100;item.offset=item.file.size;break}
+        if(item.status==='waiting_quota')throw new Error(item.error||'Google sinalizou limite/cota. Tente novamente mais tarde.');
+      }
+    }catch(e){item.status=item.status==='waiting_quota'?'waiting_quota':'error';item.error=e.message||String(e);renderQueue()}
+  }
+  async function runQueue(){
+    if(running||!queue.length||!dest?.value)return;running=true;paused=false;updateTotals();let cursor=0;const n=Math.max(1,Math.min(4,Number(document.getElementById('uploadParallel').value||2)));
+    async function worker(){while(true){const i=cursor++;if(i>=queue.length)return;const item=queue[i];if(item.cancelled||['completed','skipped'].includes(item.status))continue;await runItem(item)}}
+    await Promise.all(Array.from({length:n},worker));running=false;paused=false;renderQueue();
+  }
+
+  document.getElementById('uploadChooseFiles')?.addEventListener('click',()=>fileInput.click());document.getElementById('uploadChooseFolder')?.addEventListener('click',()=>folderInput.click());
+  fileInput?.addEventListener('change',()=>{addFiles(fileInput.files);fileInput.value=''});folderInput?.addEventListener('change',()=>{addFiles(folderInput.files);folderInput.value=''});
+  ['dragenter','dragover'].forEach(ev=>drop?.addEventListener(ev,e=>{e.preventDefault();drop.classList.add('drag')}));['dragleave','drop'].forEach(ev=>drop?.addEventListener(ev,e=>{e.preventDefault();drop.classList.remove('drag')}));drop?.addEventListener('drop',e=>addFiles(e.dataTransfer.files));
+  startBtn?.addEventListener('click',runQueue);pauseBtn?.addEventListener('click',()=>{paused=!paused;updateTotals()});document.getElementById('uploadClearQueue')?.addEventListener('click',()=>{if(running)return alert('Pause/aguarde os uploads em andamento antes de limpar a fila.');queue=[];renderQueue()});
+  document.getElementById('uploadPreserveTree')?.addEventListener('change',()=>{if(queue.length&&!confirm('Alterar esta opção limpa a seleção atual para recalcular os caminhos. Continuar?')){document.getElementById('uploadPreserveTree').checked=!document.getElementById('uploadPreserveTree').checked;return}queue=[];renderQueue()});
+  dest?.addEventListener('change',()=>{destPath='';loadDest()});document.getElementById('uploadDestUp')?.addEventListener('click',()=>{destPath=parentPath(destPath);loadDest()});document.getElementById('uploadDestRefresh')?.addEventListener('click',loadDest);document.getElementById('uploadDestNewFolder')?.addEventListener('click',createFolder);document.getElementById('uploadDestSearchBtn')?.addEventListener('click',doSearch);document.getElementById('uploadDestClearSearch')?.addEventListener('click',()=>{search.value='';loadDest()});search?.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();doSearch()}});
+  loadDest();renderQueue();
+
+  setInterval(async()=>{try{const r=await fetch('/api/uploads',{cache:'no-store'});if(!r.ok)return;const jobs=await r.json();jobs.forEach(j=>{const tr=document.querySelector(`[data-upload-job="${j.id}"]`);if(!tr)return;const st=tr.querySelector('.upload-status');if(st){st.textContent=j.status;st.className=`badge upload-status ${statusClass(j.status)}`}const pr=tr.querySelector('.upload-progress');if(pr)pr.textContent=`${Number(j.progress||0).toFixed(1)}% · ${humanBytes(j.uploaded_bytes||0)} / ${humanBytes(j.size_bytes||0)}`;const bar=tr.querySelector('.progress span');if(bar)bar.style.width=`${j.progress||0}%`;const er=tr.querySelector('.upload-error');if(er)er.textContent=j.last_error||''})}catch(e){}},3000);
+}
+
+// initialize upload page in addition to the existing dashboard/transfer initializers
+if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',initUploadPage);else initUploadPage();
